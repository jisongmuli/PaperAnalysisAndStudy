# ===================================================
#  DeepSeek API 配置（复制本文件为 .env 后修改）
#  也可以不改这里，直接在网页右上角「设置」中填写。
#  优先级：网页设置（data/config.json） > 环境变量 > 默认值
# ===================================================

DEEPSEEK_API_KEY=sk-在此填入你的密钥

# 官方地址；使用兼容代理时改成代理地址（不要带结尾斜杠）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek-flash（快速阅读）或 deepseek-v4-pro（深入推理）
DEEPSEEK_MODEL=deepseek-flash

# 后端端口，默认 8787
PORT=8787
